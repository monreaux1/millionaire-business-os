# ── Browser (safe to expose) ───────────────────────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to "false" for invite-only access (also turn off sign-ups in Supabase → Authentication)
VITE_ALLOW_SIGNUP=true

# ── Server only (Vercel → Settings → Environment Variables) ────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Supabase → Project Settings → API → service_role (secret!) — never put in VITE_ vars
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; default claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if your key is NOT created inside a workspace: the workspace ID from console.anthropic.com → Workspaces
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Resend → API Keys; EMAIL_FROM must be on a domain you verified in Resend
RESEND_API_KEY=re_...
EMAIL_FROM=briefing@yourdomain.com
# Optional: where replies go when the from-address has no inbox
# EMAIL_REPLY_TO=you@gmail.com

# Any long random string; Vercel Cron sends it to /api/cron/daily-briefing
CRON_SECRET=change-me-to-a-long-random-string

# Comma-separated admin emails
ADMIN_EMAILS=you@example.com

# Optional: owner-only fallback GHL key
# GHL_API_KEY=

# ── Billing (Stripe) — leave STRIPE_SECRET_KEY empty to keep the app open to all accounts ──
# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Stripe → Developers → Webhooks → endpoint https://YOUR-APP/api/billing/webhook → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe → Product catalog → each price's ID (price_...). Leave one blank to hide that plan.
STRIPE_PRICE_FOUNDING=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_COACHING=price_...
# Optional: founding member cap (default 50)
# FOUNDING_LIMIT=50
# Your app's public address, used for Stripe return links
APP_URL=https://app.yourdomain.com

# ── AI video ads (fal.ai) — leave FAL_KEY empty to show "coming soon" ──
# Customers buy credit packs (one-time Stripe payments; packs are set in api/_lib/video.js).
# Run supabase/migrations/003_video.sql once before turning this on.
KIE_KEY=
FAL_KEY=
# VIDEO_PROVIDER=kie   # or fal; defaults to whichever key is set (kie first)
# Optional model override (kie default: kling-3.0/video; fal default below)
# VIDEO_MODEL=fal-ai/kling-video/v3/standard/text-to-video
